# ==============================================================================
# NexDrop Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="NexDrop API"
VERSION=1.0.0

# CORS Origins (JSON list format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Connection (Neon PostgreSQL)
# Example Neon Connection string:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<ep-xyz>.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local Docker fallback:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexdrop
# NOTE: The backend starts and serves /api/v1/health even when DATABASE_URL is empty!
DATABASE_URL=

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# RabbitMQ Messaging (Optional for initial development)
# Local Docker: amqp://guest:guest@localhost:5672/
# CloudAMQP: amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_ENABLED=false
RABBITMQ_URL=

# Security & Authentication
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPABASE_URL=
# Supabase project's HS256 JWT secret, used to verify courier access tokens.
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
# Centralized Backend API URL for client-side queries
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Courier delivery mock fallback is development-only; set false to disable.
NEXT_PUBLIC_USE_MOCK_COURIER_DELIVERIES=true
